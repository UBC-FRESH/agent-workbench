{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P120 document extraction response",
  "type": "object",
  "required": ["records"],
  "additionalProperties": false,
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_type",
          "title_or_heading",
          "summary",
          "entities",
          "dates",
          "locations",
          "methods_or_actions",
          "constraints_or_thresholds",
          "evidence_quotes",
          "confidence",
          "warnings"
        ],
        "additionalProperties": false,
        "properties": {
          "record_type": {"type": "string"},
          "title_or_heading": {"type": ["string", "null"]},
          "summary": {"type": "string"},
          "entities": {"type": "array", "items": {"type": "string"}},
          "dates": {"type": "array", "items": {"type": "string"}},
          "locations": {"type": "array", "items": {"type": "string"}},
          "methods_or_actions": {"type": "array", "items": {"type": "string"}},
          "constraints_or_thresholds": {"type": "array", "items": {"type": "string"}},
          "evidence_quotes": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
