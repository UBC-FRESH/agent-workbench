# Copy outside the repository, then replace the placeholder values locally.
# The base URL must end in the OpenAI-compatible /v1 path.
AW_SCRAPER_BASE_URL=http://127.0.0.1:PORT/v1
AW_SCRAPER_MODEL=REPLACE_WITH_LOCAL_GGUF_MODEL_NAME
AW_SCRAPER_API_KEY=
AW_SCRAPER_TIMEOUT_SECONDS=90
AW_SCRAPER_MAX_TOKENS=1200
AW_SCRAPER_TEMPERATURE=0
AW_SCRAPER_JSON_MODE=true
