# Ollama exposes an OpenAI-compatible API at its local /v1 endpoint.
# Use a compact locally installed model for the first CPU smoke test.
AW_SCRAPER_BASE_URL=http://127.0.0.1:11434/v1
AW_SCRAPER_MODEL=llama3.1:latest
AW_SCRAPER_API_KEY=
AW_SCRAPER_TIMEOUT_SECONDS=180
AW_SCRAPER_MAX_TOKENS=1200
AW_SCRAPER_TEMPERATURE=0
AW_SCRAPER_JSON_MODE=true
